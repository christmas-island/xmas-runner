# xmas-runner environment configuration
# Copy this to .env and fill in your values

# --- Authentication (choose ONE method) ---

# Method 1: Direct runner registration token (from GitHub UI)
# Settings → Actions → Runners → New self-hosted runner → copy the token
# NOTE: These expire in ~1 hour. If your container restarts, you'll need a new one.
# Use GITHUB_PAT below for persistent runners that survive restarts.
# RUNNER_TOKEN=AXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Method 2: Classic PAT with admin:org scope (recommended for persistent runners)
# IMPORTANT: Fine-grained PATs do NOT support self-hosted runner management.
# You must use a CLASSIC PAT with the `admin:org` scope.
# Generate one at: https://github.com/settings/tokens
GITHUB_PAT=ghp_your_classic_pat_here

# Runner scope: 'org' for org-level, 'repo' for repo-level
RUNNER_SCOPE=org

# Target: org name (for org scope) or owner/repo (for repo scope)
RUNNER_TARGET=christmas-island

# Runner display name (defaults to container hostname)
RUNNER_NAME=xmas-runner-local

# Comma-separated labels — must match your workflow's `runs-on` value
# Include xmas-isle to pick up jobs from christmas-island workflows
RUNNER_LABELS=self-hosted,linux,X64,xmas-isle,xmas-runner

# Runner group (must exist in org settings)
RUNNER_GROUP=default

# Ephemeral: exit after one job (true = better for CI, false = better for local persistent runners)
EPHEMERAL=false

# GitHub base URL (change for GitHub Enterprise Server)
GITHUB_URL=https://github.com
