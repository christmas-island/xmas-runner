# xmas-runner environment configuration
# Copy this to .env and fill in your values

# GitHub PAT with admin:org scope (for org runners) or repo scope (for repo runners)
GITHUB_PAT=ghp_your_token_here

# Runner scope: 'org' for org-level, 'repo' for repo-level
RUNNER_SCOPE=org

# Target: org name (for org scope) or owner/repo (for repo scope)
RUNNER_TARGET=christmas-island

# Runner display name (defaults to container hostname)
RUNNER_NAME=xmas-runner-local

# Comma-separated labels
RUNNER_LABELS=self-hosted,linux,x64,xmas-runner

# Runner group (must exist in org settings)
RUNNER_GROUP=default

# Ephemeral: exit after one job (recommended for CI)
EPHEMERAL=true

# GitHub base URL (change for GitHub Enterprise Server)
GITHUB_URL=https://github.com
